{
  "name": "vscode-sync-storage",
  "displayName": "Sync Storage",
  "description": "Store and sync arbitrary files across VS Code instances using built-in settings sync",
  "version": "0.1.0",
  "publisher": "benpm",
  "repository": {
    "type": "git",
    "url": "https://github.com/benpm/vscode-sync-storage.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sync",
    "storage",
    "workspace",
    "settings-sync",
    "virtual-filesystem"
  ],
  "activationEvents": [
    "onFileSystem:syncstore"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "syncStorage.openWorkspace",
        "title": "Open Sync Storage Workspace"
      },
      {
        "command": "syncStorage.newFile",
        "title": "Sync Storage: New File"
      },
      {
        "command": "syncStorage.clearStorage",
        "title": "Sync Storage: Clear All Files"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "@vscode/vsce": "^2.22.0"
  }
}
